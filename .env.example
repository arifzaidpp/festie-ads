# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth: 32+ random characters (openssl rand -base64 36) and the public origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# S3-compatible media bucket (festie uses Wasabi). Public read; CORS must allow PUT from the app origin.
S3_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=https://files.example.com
# Every object key starts with this prefix
S3_KEY_PREFIX=festie-ads/

# Encrypts festie tokens/secrets at rest: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Festie app registration (Control > Apps): admin origin, API origin, client credentials.
# Registered callback must be ${BETTER_AUTH_URL}/api/festie/callback
FESTIE_ADMIN_URL=http://localhost:5173
FESTIE_API_URL=http://localhost:4000
FESTIE_CLIENT_ID=
FESTIE_CLIENT_SECRET=

# Festie signs its calls to this engine with it (shown once in Control)
FESTIE_WEBHOOK_SECRET=

# Optional: Google sign in. Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
